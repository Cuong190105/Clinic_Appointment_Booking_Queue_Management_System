{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "http://localhost:5000",
    "Audience": "Clinic.Services",
    "PublicBaseUrl": "http://localhost:5001",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SigningKeyDirectory": "var/identity-keys"
  }
}
