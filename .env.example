# Database Configuration
DB_CONNECTION_STRING=Server=db,1433;Database=ClinicDB;User Id=sa;Password=replace-with-a-random-sql-password;TrustServerCertificate=True;
DB_SA_PASSWORD=replace-with-a-random-sql-password

# JWT Security
JWT_KEY=replace-with-a-random-secret-at-least-32-bytes-long

# RabbitMQ (Microservices)
RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password

# Email / Notification (Mock provider for testing/benchmarks)
SMTP_USERNAME=mock-notifications@clinic.local
SMTP_PASSWORD=replace-with-mock-or-smtp-password
SMTP_HOST=mock

# Internal Service Tokens
IDENTITY_SERVICE_TOKEN=replace-with-a-separate-random-secret-at-least-32-bytes-long
