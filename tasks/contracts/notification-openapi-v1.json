              "string"
            ]
          },
          "resetToken": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "JWT Bearer access token",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "ServiceToken": {
        "type": "apiKey",
        "description": "Internal service-to-service token",
        "name": "X-Clinic-Service-Token",
        "in": "header"
